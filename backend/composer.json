{
  "name": "capsgo-backend",
  "description": "Laravel backend for CAPSGO project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": ["php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "post-create-project-cmd": ["php artisan key:generate"]
  }
}
